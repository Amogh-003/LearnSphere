# Application
PROJECT_NAME=LearnSphere
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=sqlite+aiosqlite:///./learnsphere.db

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional email (console by default)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@learnsphere.local